# ACOMI Web — copy to `.env` for local development.
# Use relative `/api/v1` so Vite proxies to Spring Boot (avoids CORS).
# Production builds use `.env.production` (https://api.acomi.in/api/v1).
# Render build-time env, if set, overrides these files.

VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT_MS=30000
VITE_APP_ENV=development
# Public marketing site (Back to website from auth). Dev default is localhost:5174.
# VITE_PUBLIC_SITE_ORIGIN=http://localhost:5174
# Official Play Store listing for “Open ACOMI App” fallback (default: com.acomi).
# VITE_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.acomi

